{
    "name": "coupled-modelling-frontend",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "test": "vitest",
        "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=junit.xml",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write src eslint.config.mjs next.config.ts postcss.config.mjs vitest.config.mts",
        "format:check": "prettier --check src eslint.config.mjs next.config.ts postcss.config.mjs vitest.config.mts",
        "type-check": "tsc --noEmit",
        "generate:api-types": "openapi-typescript http://localhost:5000/api/v1.0/openapi.yaml -o src/types/openapi.ts"
    },
    "dependencies": {
        "@heroui/react": "^3.2.4",
        "@heroui/styles": "^3.2.4",
        "classnames": "^2.5.1",
        "ky": "^1.14.3",
        "next": "16.3",
        "next-themes": "^0.4.6",
        "nuqs": "^2.8.9",
        "react": "^19.2.8",
        "react-aria-components": "^1.20.0",
        "react-dom": "^19.2.8",
        "react-resizable-panels": "^3",
        "swr": "^2"
    },
    "devDependencies": {
        "@eslint/js": "^9",
        "@tailwindcss/postcss": "^4.3.0",
        "@testing-library/jest-dom": "^6",
        "@testing-library/react": "^16",
        "@testing-library/user-event": "^14.6.6",
        "@types/node": "^24",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^5",
        "eslint": "^9",
        "eslint-config-next": "16.3",
        "eslint-config-prettier": "^10",
        "eslint-plugin-no-relative-import-paths": "^1",
        "eslint-plugin-simple-import-sort": "^12",
        "jsdom": "^26",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3",
        "tailwindcss": "^4.3.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8",
        "vitest": "^3"
    }
}
